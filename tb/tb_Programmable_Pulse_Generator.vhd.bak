library IEEE; 
use IEEE.std_logic_1164.all;

entity tb_Programmable_Pulse_Generator is
end entity; 

architecture testbench of tb_Programmable_Pulse_Generator is 
    
    constant N: positive := 8; 
    constant CLK_PERIOD: TIME := 100 ns; 
    constant RESET_TIME: TIME := CLK_PERIOD;

    component Programmable_Pulse_Generator
        generic(
            Nbit: positive := 8
        );
        port(
            load_delay: in std_logic;
            load_length: in std_logic;
            
            data: in std_logic_vector (Nbit-1 downto 0);
            
            resetn: in std_logic;
            clk: in std_logic;

            pulse: out std_logic
        );
    end component; 

    signal clk: std_logic := '0'; 
    signal resetn: std_logic := '0';

    signal testing: boolean := true; 

    signal load_delay: std_logic := '1';
    signal load_length: std_logic := '1';

    signal data: std_logic_vector (N-1 downto 0);
    signal pulse: std_logic;

begin
    prog_pulse_gen: Programmable_Pulse_Generator
        generic map(
            Nbit => N
        )
        port map(
            load_delay => load_delay,
            load_length => load_length,
            
            clk => clk,
            resetn => resetn, 

            data => data,
            pulse => pulse
        );

        clk <= not clk after CLK_PERIOD/2 when testing else '0';

        stimuli: process
        begin
            
            report "CASO 1: reset iniziale e stato di riposo";
            load_length <= '0';
            load_delay <= '0'; 
            data <= x"02";
            wait for RESET_TIME;    

            report "CASO 2: programmazione parziale nessun avvio";
            resetn <= '1';
            load_length <= '0'; 
            load_delay <= '1';
            data <= x"03"; 
            wait for CLK_PERIOD;

            report "CASO 3: programmazione completa, comportamento canonico";
            load_length <= '1';
            load_delay <= '0';
            data <= x"02";
            wait for CLK_PERIOD; 

            load_length <= '1';
            load_delay <= '1';
            wait for CLK_PERIOD*3; 

            report "CASO 4: programmazione limite durata impulso";
            load_length <= '0'; 
            load_delay <= '1'; 
            data <= x"01";
            wait for CLK_PERIOD;
            
            load_length <= '1'; 
            load_delay <= '1';
            wait for CLK_PERIOD*3; 
            
            report "CASO 5: onda quadra";
            load_length <= '0';
            load_delay <= '0'; 
            data <= x"02";   
            wait for CLK_PERIOD; 

            load_length <= '1'; 
            load_delay <= '1';
            wait for CLK_PERIOD*4;
            
            report "CASO 6: scritture multiple delay e riprogrammazione a metà fase";
            load_length <= '1'; 
            load_delay <= '0'; 
            data <= x"01";
            wait for CLK_PERIOD; 

            data <= x"02";
            wait for CLK_PERIOD; 

            data <= x"03";
            wait for CLK_PERIOD*5; 

            report "CASO 7: stato idle per delay settato a 0";
            load_length <= '1'; 
            load_delay <= '0'; 
            data <= x"00";   
            wait for CLK_PERIOD*2;

            report "CASO 8: reset durante pulse";
            load_length <= '0'; 
            load_delay <= '1'; 
            data <= x"04";   
            wait for CLK_PERIOD;

            load_length <= '1'; 
            load_delay <= '0'; 
            data <= x"02";   
            wait for CLK_PERIOD*2;

            wait for CLK_PERIOD/4;
            resetn <= '0';
            wait until falling_edge(clk); 

            wait for CLK_PERIOD/4;
            resetn <= '1'; 
            wait until falling_edge(clk);

            load_length <= '0'; 
            load_delay <= '0'; 
            data <= x"02";   
            wait for CLK_PERIOD;

            load_length <= '1'; 
            load_delay <= '1';  
            wait for CLK_PERIOD*5;

            report "Simulation end ...";
            testing <= false; 
            wait until rising_edge(clk);   
    end process; 
end architecture;